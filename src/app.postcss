/* Write your global styles here, in PostCSS syntax */
@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer utilities{
	.text-black{
		color: #212529;
	}
	
	.container{
		@apply px-4;
	}
}

@layer base{
	html,body{
		@apply text-black;
		font-family: 'Roboto', sans-serif;
		scroll-behavior: smooth;
	}

	section {
		@apply py-12;
	}


	h1{
		@apply text-5xl;
		@apply text-center;
		@apply font-light;
		@apply mb-12;
	}

	h2{
		@apply text-3xl;
	}

	h3{
		@apply text-xl;
	}

	h4{
		@apply text-lg;
	}

	h5{
		@apply text-base
	}

	.bg-gradient{
		background: linear-gradient(314deg, #460c6b, #071b63, #2b0852, #102c56, #1e053e);
		background-size: 800% 800%;
		animation: GradientBackground 20s ease-in-out infinite;
		@apply text-white;
	}
	@-webkit-keyframes GradientBackground{0%{background-position:0 22%}50%{background-position:100% 79%}to{background-position:0 22%}}
	@keyframes GradientBackground{0%{background-position:0 22%}50%{background-position:100% 79%}to{background-position:0 22%}}
}


@layer custom {
	*,*:before, *:after {
		margin: 0;
		padding: 0;
		border: 0;
		font-size: 100%;
		font: inherit;
		vertical-align: baseline;
		box-sizing: border-box;
	}
	
	html, body{
		height: 100%;
	}
	
	/* HTML5 display-role reset for older browsers */
	article, aside, details, figcaption, figure, 
	footer, header, hgroup, menu, nav, section {
		display: block;
	}
	body {
		line-height: 1;
	}
	ol, ul {
		list-style: none;
	}
	blockquote, q {
		quotes: none;
	}
	blockquote:before, blockquote:after,
	q:before, q:after {
		content: '';
		content: none;
	}
	table {
		border-collapse: collapse;
		border-spacing: 0;
	}
	a:hover,
	a:focus,
	a:link{
		color: inherit;
	}


	#topdiv {
		margin: 0 10% 0 10%;
		@apply text-white;
	}

	li.nav-link{
		@apply mx-3;
		@apply hover:text-blue-500;
		@apply transition-all;
		@apply duration-150;

	}
}
